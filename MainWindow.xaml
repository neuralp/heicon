<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="heicon.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:heicon"
    xmlns:models="using:heicon.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Heicon">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid"
          AllowDrop="True"
          DragOver="RootGrid_DragOver"
          DragLeave="RootGrid_DragLeave"
          Drop="RootGrid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar" Height="48" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE91B;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Heicon" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Commands -->
        <Grid Grid.Row="1" Padding="16,0,16,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CommandBar HorizontalAlignment="Left" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
                <AppBarButton x:Name="AddFilesButton" Label="Add files" Click="AddFilesButton_Click"
                              ToolTipService.ToolTip="Add .heic / .heif files">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8E5;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="AddFolderButton" Label="Add folder" Click="AddFolderButton_Click"
                              ToolTipService.ToolTip="Add every .heic / .heif file in a folder">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8F4;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton x:Name="RemoveSelectedButton" Label="Remove" Click="RemoveSelectedButton_Click"
                              IsEnabled="False" ToolTipService.ToolTip="Remove selected files from the list (Delete)">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="ClearFinishedButton" Label="Clear finished" Click="ClearFinishedButton_Click"
                              ToolTipService.ToolTip="Remove converted and skipped files from the list">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE930;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="ClearAllButton" Label="Clear all" Click="ClearAllButton_Click"
                              ToolTipService.ToolTip="Remove every file from the list">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE894;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>

            <TextBlock x:Name="CountText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="No files" />
        </Grid>

        <!-- File list -->
        <Grid Grid.Row="2"
              Margin="16,0,16,0"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="8">

            <ListView x:Name="FileList"
                      ItemsSource="{x:Bind Items}"
                      SelectionMode="Extended"
                      Padding="0,4"
                      KeyDown="FileList_KeyDown"
                      SelectionChanged="FileList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ConversionItem">
                        <Grid Padding="0,8" ColumnSpacing="12" ToolTipService.ToolTip="{x:Bind SourcePath}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" MaxWidth="360" />
                            </Grid.ColumnDefinitions>

                            <FontIcon VerticalAlignment="Center"
                                      FontSize="16"
                                      Glyph="{x:Bind local:MainWindow.GetStatusGlyph(Status), Mode=OneWay}"
                                      Foreground="{x:Bind local:MainWindow.GetStatusBrush(Status), Mode=OneWay}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind FolderPath}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{x:Bind Message, Mode=OneWay}"
                                       Foreground="{x:Bind local:MainWindow.GetStatusBrush(Status), Mode=OneWay}"
                                       ToolTipService.ToolTip="{x:Bind Message, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Empty state -->
            <StackPanel x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        IsHitTestVisible="False">
                <FontIcon Glyph="&#xEB9F;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock HorizontalAlignment="Center"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Text="Drop .heic files or folders here" />
                <TextBlock HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="or use Add files / Add folder above" />
            </StackPanel>

            <!-- Drag highlight -->
            <Border x:Name="DropHighlight"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    CornerRadius="8"
                    BorderThickness="2"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
        </Grid>

        <InfoBar x:Name="StatusInfoBar"
                 Grid.Row="3"
                 Margin="16,12,16,0"
                 IsOpen="False" />

        <!-- Options and actions -->
        <Grid Grid.Row="4" Padding="16" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <RadioButtons x:Name="FormatButtons"
                              Header="Output format"
                              MaxColumns="2"
                              SelectedIndex="0"
                              SelectionChanged="FormatButtons_SelectionChanged">
                    <RadioButton Content="JPEG (.jpg)" />
                    <RadioButton Content="PNG (.png)" />
                </RadioButtons>

                <Slider x:Name="QualitySlider"
                        Grid.Column="1"
                        Header="JPEG quality: 90"
                        Minimum="50"
                        Maximum="100"
                        StepFrequency="1"
                        TickFrequency="10"
                        TickPlacement="Outside"
                        Value="90"
                        ValueChanged="QualitySlider_ValueChanged" />

                <ToggleSwitch x:Name="SubfoldersToggle"
                              Grid.Column="2"
                              Header="Include subfolders"
                              IsOn="True"
                              ToolTipService.ToolTip="When adding a folder, also search its subfolders" />
            </Grid>

            <StackPanel Grid.Row="1" Spacing="2">
                <CheckBox x:Name="InPlaceCheckBox"
                          Content="Convert in place (delete the original .heic after converting)"
                          Checked="InPlaceCheckBox_Changed"
                          Unchecked="InPlaceCheckBox_Changed" />
                <TextBlock x:Name="InPlaceHint"
                           Margin="28,0,0,0"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Text="Converted files are always saved next to the originals. With this on, each original is permanently deleted once its converted copy is written." />
            </StackPanel>

            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Spacing="6">
                    <ProgressBar x:Name="ConversionProgress" Visibility="Collapsed" />
                    <TextBlock x:Name="SummaryText"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button x:Name="CancelButton"
                        Grid.Column="1"
                        MinWidth="100"
                        Content="Cancel"
                        Visibility="Collapsed"
                        Click="CancelButton_Click" />

                <Button x:Name="ConvertButton"
                        Grid.Column="2"
                        MinWidth="140"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="ConvertButton_Click"
                        IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE895;" FontSize="14" />
                        <TextBlock Text="Convert" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
